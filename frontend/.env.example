# ==============================================================================
# AML Mule Account Detection Frontend - Environment Configuration
# ==============================================================================
# 
# Central API Base URL Configuration:
# Set this to the URL of your existing FastAPI / Flask / Python backend server.
#
# Examples:
#   VITE_API_BASE_URL=http://localhost:8000
#   VITE_API_BASE_URL=http://127.0.0.1:5000/api/v1
#
# When left empty or unset, the frontend runs in offline development mode,
# using clearly labeled illustrative mock data without pretending a backend exists.
# ==============================================================================

VITE_API_BASE_URL=http://localhost:8000/api/v1
